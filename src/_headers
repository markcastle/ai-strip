# Applied by Cloudflare Pages to static responses. This file is not served.
# CSP allows the inlined CSS/JS this page ships with, and blob: URLs for the
# local thumbnail and the cleaned download. connect-src 'none' matches the
# product rule: the page must not make network requests.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src blob: data:; connect-src 'none'; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
